# ---------------------------------------------------------------------------
# Konfigurace webu Chalupy ROCKytnice
# Zkopírujte tento soubor do .env.local a vyplňte hodnoty.
# Na Vercelu nastavte tyto proměnné v Project Settings → Environment Variables.
# ---------------------------------------------------------------------------

# --- Zdroj pravdy o obsazenosti: GOOGLE KALENDÁŘ ---
# Tajná adresa kalendáře ve formátu iCal. Získáte v Google Kalendáři:
# Nastavení kalendáře → "Integrace kalendáře" → "Tajná adresa ve formátu iCal".
# Odkaz končí na /basic.ics — vložte ho celý.
GOOGLE_CALENDAR_ICAL_URL=

# (Volitelné) Další zdroje obsazenosti, které se sloučí s Google kalendářem.
# Např. iCal export z administrace e-chalupy.cz (varianta "včetně podrobností"):
# https://klient.e-chalupy.cz/obsazenost-export-ics/
ECHALUPY_ICAL_URL=
# Případně víc zdrojů najednou, oddělených čárkou:
AVAILABILITY_ICAL_URLS=

# Kam se mají posílat poptávky z rezervačního formuláře.
RESERVATION_EMAIL=info@chalupa-rockytnice.cz

# --- Odesílání e-mailů přes Resend (https://resend.com) ---
# Bez tohoto klíče web funguje, ale poptávky se pouze zapíší do logu serveru
# (nikam se neodešlou). Pro reálný provoz doporučujeme nastavit.
RESEND_API_KEY=
# Odesílací adresa musí být na ověřené doméně v Resendu.
RESEND_FROM=rezervace@chalupa-rockytnice.cz
